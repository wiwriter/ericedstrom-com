---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Eric Kent Edstrom"
  description="Fantasy and science fiction by Eric Kent Edstrom: Starside Saga, The Scion Chronicles, and The Undermountain Saga."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="meta">Author · Wisconsin</p>
      <h1>Stories of thieves, prophecy, and stubborn hope.</h1>
      <p>
        I’m Eric Kent Edstrom. I write fantasy and science fiction — the epic Starside Saga, the YA
        dystopian Scion Chronicles, and The Undermountain Saga adventures. I live in
        Wisconsin with my wife, daughter, and one Brittany dog.
      </p>
      <p>
        Start with a free Starside tale, or jump into the catalog for boxed sets and individual
        books in ebook, paperback, and (for some titles) audiobook.
      </p>
      <div class="cta-row">
        <a class="button" href="/free-starside-story/">Get a free Starside story</a>
        <a class="button-secondary" href="/buy-my-books/">Browse the catalog</a>
      </div>
    </div>
    <div class="hero-photo">
      <img
        src="/images/thief-of-sparks.jpg"
        alt="Cover of Thief of Sparks, book one of Starside Saga"
        width="400"
        height="638"
      />
    </div>
  </section>

  <section class="quotes" aria-label="Reader reviews">
    <blockquote>
      “This is my 2nd reading of the series. I can be very assured that I will read it for a 3rd
      time in another couple years. That thought brings me eagerness for the passing of time. It’s
      such a wonderful series that it will prove timeless. Enjoy!”
      <cite>— Andria, Amazon review</cite>
    </blockquote>
    <blockquote>
      “Thief of Sparks is a delightful introduction to a new fantasy series.”
      <cite>— HLP, Amazon review</cite>
    </blockquote>
    <blockquote>
      “…full of action and an entirely new magic system that is very cool, magic and telepathic
      cats.”
      <cite>— Frank G., Amazon reviewer</cite>
    </blockquote>
  </section>

  <section>
    <h2>Start here</h2>
    <div class="feature-grid">
      <article class="book-card">
        <img src="/images/thief-of-sparks.jpg" alt="Cover of Thief of Sparks" width="400" height="600" />
        <div class="book-card-body">
          <h3>Thief of Sparks</h3>
          <p>Starside Saga begins with Kila Sigh, a sixteen-year-old thief awakening to magic she cannot control.</p>
          <p class="retailers">
            <a href="/newsletter/">Get the free ebook</a>
            <a href="https://amzn.to/3czHr0E" rel="noopener noreferrer">Amazon</a>
          </p>
        </div>
      </article>
      <article class="book-card">
        <img src="/images/daughter-of-nothing.jpg" alt="Cover of Daughter of Nothing" width="400" height="600" />
        <div class="book-card-body">
          <h3>Daughter of Nothing</h3>
          <p>
            Divergent and Hunger Games readers have raved about The Scion Chronicles. Available in
            ebook, paperback, and audiobook.
          </p>
          <p class="retailers">
            <a href="https://books2read.com/daughter-of-nothing" rel="noopener noreferrer">Start now</a>
          </p>
        </div>
      </article>
      <article class="book-card">
        <img src="/images/vale-of-semuin.jpg" alt="Cover of Vale of Semūin" width="400" height="600" />
        <div class="book-card-body">
          <h3>Vale of Semūin</h3>
          <p>A free Starside Tale. Sign up and download the story.</p>
          <p class="retailers">
            <a href="/free-starside-story/">Download free</a>
          </p>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>